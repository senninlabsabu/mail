PORT=3000

# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role キーはサーバー専用です。ブラウザ・フロントエンドに絶対に出さないでください。
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# 12文字以上のランダム文字列 (例: openssl rand -hex 32)
SESSION_SECRET=replace-this-with-a-long-random-secret

# 初回起動時に作成される管理者 (12文字以上)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-long-password

# 本番では production にするとセッションCookieがSecure属性付きになります (HTTPS必須)
NODE_ENV=development
